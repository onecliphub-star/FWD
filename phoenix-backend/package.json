{
  "name": "phoenix-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Project Phoenix API - Express + MongoDB (Mongoose)",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/seed.ts --reset",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.43",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "2.1.9",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}